#!/bin/bash
# AuraOS First Boot Setup
set -e

# Generate locale
locale-gen

# Set timezone to UTC (user can change later)
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc

# Create xdg directories
xdg-user-dirs-update

# Create default user 'aura' if it doesn't exist
if ! id -u aura &>/dev/null; then
    useradd -m -G wheel,audio,video,storage,network,bluetooth -s /bin/bash aura
    echo "aura:aura" | chpasswd
    echo "Created user: aura (password: aura)"
fi

# Enable sudo for wheel group
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/99-wheel
chmod 440 /etc/sudoers.d/99-wheel

# Configure greetd to auto-login as aura for live mode
cat > /etc/greetd/config.toml << 'EOF'
[terminal]
vt = 1

[default_session]
command = "tuigreet --cmd Hyprland --time --asterisks --user aura"
user = "greetd"
EOF

# Mark firstboot as done
touch /var/lib/auraos/firstboot-done

echo "AuraOS first boot setup complete."
echo "Login: aura / aura"
